[global]
    monitor = 0
    follow = keyboard
    width = (300, 420)
    height = (0, 300)
    origin = top-right
    offset = (12, 36)
    notification_limit = 5
    font = Monospace 10
    frame_width = 2
    frame_color = "#50fa7b"
    corner_radius = 4
    separator_color = frame
    markup = full
    format = "<b>%s</b>\n%b"
    browser = /usr/bin/xdg-open
    dmenu = rofi -dmenu -p dunst

[urgency_low]
    background = "#1e222a"
    foreground = "#f8f8f2"
    timeout = 5

[urgency_normal]
    background = "#1e222a"
    foreground = "#f8f8f2"
    timeout = 8

[urgency_critical]
    background = "#1e222a"
    foreground = "#ff5555"
    frame_color = "#ff5555"
    timeout = 0
