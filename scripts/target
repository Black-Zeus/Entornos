#!/usr/bin/env bash
set -Eeuo pipefail

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
state_dir="$state_home/parrot-security-lab"
target_file="$state_dir/target"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

usage() {
  cat <<'EOF'
Uso:
  target <IPv4> [nombre]
  target show
  target clear
EOF
}

valid_ipv4() {
  local address="$1" octet
  local -a octets
  [[ "$address" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
  IFS='.' read -r -a octets <<< "$address"
  for octet in "${octets[@]}"; do
    ((10#$octet <= 255)) || return 1
  done
}

refresh_polybar() {
  local pid
  command -v polybar-msg >/dev/null 2>&1 || return 0
  pid="$(pgrep -u "$UID" -f 'polybar .* target$' | head -n 1)"
  [[ -n "$pid" ]] || return 0
  polybar-msg -p "$pid" action '#target.hook.0' >/dev/null
}

case "${1:-}" in
  show)
    "$script_dir/target-status.sh"
    ;;
  clear)
    rm -f -- "$target_file"
    refresh_polybar
    printf 'Objetivo eliminado.\n'
    ;;
  ''|--help|-h)
    usage
    ;;
  *)
    address="$1"
    name="${2:-}"
    valid_ipv4 "$address" || {
      printf 'ERROR: IPv4 inválida: %s\n' "$address" >&2
      exit 2
    }
    [[ -z "$name" || "$name" != *$'\n'* ]] || {
      printf 'ERROR: el nombre contiene caracteres inválidos.\n' >&2
      exit 2
    }
    mkdir -p -- "$state_dir"
    umask 077
    temp_file="$(mktemp "$state_dir/.target.XXXXXX")"
    trap 'rm -f -- "$temp_file"' EXIT
    printf '%s %s\n' "$address" "$name" > "$temp_file"
    mv -- "$temp_file" "$target_file"
    trap - EXIT
    refresh_polybar
    printf 'Objetivo fijado: %s' "$address"
    [[ -n "$name" ]] && printf ' (%s)' "$name"
    printf '\n'
    ;;
esac
